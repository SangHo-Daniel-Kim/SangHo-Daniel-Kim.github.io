---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="name-text"><span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}</span>
      {% else %}
        {{ site.title }}
      {% endif %}
      <span class="header-social-icons">
        <a href="https://scholar.google.com/citations?user=jWO1NB8AAAAJ" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>
        <a href="mailto:sanghokim@utexas.edu" title="email"><i class="fa-solid fa-envelope"></i></a>
        <a href="https://www.linkedin.com/in/danieliscoding" title="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
      </span>
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.hover_image %}
            {% assign profile_hover_image_path = page.profile.hover_image | prepend: 'assets/img/' %}
          {% endif %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {% if page.profile.hover_image %}
            {% if page.profile.hover_image2 %}
              {% assign profile_hover_image2_path = page.profile.hover_image2 | prepend: 'assets/img/' %}
            {% endif %}
            <div class="profile-card-stack" aria-label="Profile image">
              {% if page.profile.hover_image2 %}
                <div class="profile-card" data-pos="2">
                  {%
                    include figure.liquid loading="eager" path=profile_hover_image2_path class=profile_image_class sizes=sizes alt=page.profile.hover_image2
                    cache_bust=true
                  %}
                </div>
              {% endif %}
              <div class="profile-card" data-pos="{% if page.profile.hover_image2 %}1{% else %}1{% endif %}">
                {%
                  include figure.liquid loading="eager" path=profile_hover_image_path class=profile_image_class sizes=sizes alt=page.profile.hover_image
                  cache_bust=true
                %}
              </div>
              <div class="profile-card" data-pos="0">
                {%
                  include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
                  cache_bust=true
                %}
              </div>
            </div>
            <script>
              document.addEventListener('DOMContentLoaded', function () {
                var stack = document.querySelector('.profile-card-stack');
                if (!stack) return;
                var cards = Array.from(stack.querySelectorAll('.profile-card'));
                var n = cards.length;

                function bringToFront(clickedPos) {
                  if (stack.dataset.animating === 'true') return;
                  stack.dataset.animating = 'true';
                  var clickedCard = cards.find(function(c) { return c.dataset.pos === String(clickedPos); });
                  clickedCard.style.zIndex = '10';
                  cards.forEach(function(c) {
                    var pos = parseInt(c.dataset.pos);
                    c.dataset.pos = c === clickedCard ? '0' : String((pos + (n - clickedPos)) % n);
                  });
                  setTimeout(function() {
                    clickedCard.style.zIndex = '';
                    stack.dataset.animating = 'false';
                  }, 680);
                }

                stack.addEventListener('click', function(e) {
                  var clicked = e.target.closest('.profile-card');
                  if (!clicked) return;
                  var pos = parseInt(clicked.dataset.pos);
                  if (pos > 0) bringToFront(pos);
                });
              });
            </script>
          {% else %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="about-section-heading">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Projects -->
    {% if page.projects_home %}
      <h2 class="about-section-heading">
        <a href="{{ '/projects/' | relative_url }}" style="color: inherit">Projects</a>
        <span class="coming-soon">(Coming Soon!)</span>
      </h2>
      {% include projects_home.liquid %}
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="about-section-heading">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Scholarships & Honors -->
    {% if page.honors_home %}
      <h2 class="about-section-heading">Scholarships &amp; Honors</h2>
      {% include honors_home.liquid %}
    {% endif %}

    <!-- Public Service -->
    {% if page.public_service_home %}
      <h2 class="about-section-heading">Public Service</h2>
      {% include public_service_home.liquid %}
    {% endif %}


    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
