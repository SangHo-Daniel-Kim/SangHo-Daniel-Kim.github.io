<div class="news{% if include.limit %} news-home{% endif %}">
  {% if site.news != blank %}
    {% assign all_news = site.news | sort: 'date' | reverse %}

    {% if include.limit %}
      <!-- Home page: selected items only, no scroll -->
      {% assign home_news = all_news | where: "home", true %}
      {% if home_news.size > 0 %}
        <table class="table table-sm table-borderless">
          {% for item in home_news %}
            <tr>
              <th scope="row" style="width: 22%; white-space: nowrap;">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      {% else %}
        <p>No news so far...</p>
      {% endif %}
    {% else %}
    {% assign academic_news = all_news | where: "category", "academic" %}
    {% assign extra_news = all_news | where: "category", "extracurricular" %}

    <!-- Academic News -->
    {% if academic_news.size > 0 %}
      <h5 class="news-section-title">Academic</h5>
      <div class="table-responsive" style="max-height: 13rem; overflow-y: auto; margin-bottom: 1.5rem;">
        <table class="table table-sm table-borderless">
          {% for item in academic_news %}
            <tr>
              <th scope="row" style="width: 22%; white-space: nowrap;">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% endif %}

    <!-- Extracurricular News -->
    {% if extra_news.size > 0 %}
      <h5 class="news-section-title">Extracurricular</h5>
      <div class="table-responsive" style="max-height: 13rem; overflow-y: auto;">
        <table class="table table-sm table-borderless">
          {% for item in extra_news %}
            <tr>
              <th scope="row" style="width: 22%; white-space: nowrap;">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% endif %}
    {% endif %}

  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
