{% assign life_page = site.data.life_page %}

<div class="life-page collection-page">
  <div class="collection-header">
    <h1>Life</h1>
    <h2>stories, thoughts, and things I care about</h2>
    {% if life_page.updated %}
      <p class="collection-updated">Updated {{ life_page.updated | date: '%b %d, %Y' }}</p>
    {% endif %}
    {% if life_page.intro_label or life_page.intro %}
      <p class="collection-intro">
        {% if life_page.intro_label %}
          <span class="collection-intro-label">{{ life_page.intro_label }}</span>
        {% endif %}
        {% if life_page.intro %}
          <span class="collection-intro-text">{{ life_page.intro }}</span>
        {% endif %}
      </p>
    {% endif %}
  </div>

  {% for section in life_page.sections %}
    <section class="collection-section life-section" id="{{ section.id }}">
      <div class="collection-section-heading">
        <h3>{{ section.title }}</h3>
        {% if section.subtitle %}
          <span class="collection-section-subtitle">{{ section.subtitle }}</span>
        {% endif %}
      </div>

      <div class="life-story-stream">
        {% if life_page.story_rows.size > 0 %}
          {% for row in life_page.story_rows %}
            {% assign image_side = row.image_side | default: 'left' %}
            <article class="life-story-row life-story-row--image-{{ image_side }}">
              {% if row.image %}
                <figure class="life-story-media">
                  <img
                    src="{{ row.image | relative_url }}"
                    alt="{{ row.image_alt | default: '' }}"
                    loading="lazy"
                  />
                  {% if row.image_caption %}
                    <figcaption>{{ row.image_caption }}</figcaption>
                  {% endif %}
                </figure>
              {% endif %}
              {% if row.text %}
                <div class="life-story-prose">{{ row.text | markdownify }}</div>
              {% endif %}
            </article>
          {% endfor %}
        {% else %}
          <p class="life-story-placeholder">Story entries with photos will appear here soon.</p>
        {% endif %}
      </div>
    </section>
  {% endfor %}
</div>
