{% assign about_page = site.data.about_page %}

<div class="about-page collection-page">
  <div class="collection-header">
    <h1>About</h1>
    <h2>academic, extracurricular, social impact &mdash; and beyond</h2>
    {% if about_page.updated %}
      <p class="collection-updated">Updated {{ about_page.updated | date: '%b %d, %Y' }}</p>
    {% endif %}
    {% if about_page.intro_label or about_page.intro %}
      <p class="collection-intro">
        {% if about_page.intro_label %}
          <span class="collection-intro-label">{{ about_page.intro_label }}</span>
        {% endif %}
        {% if about_page.intro %}
          <span class="collection-intro-text">{{ about_page.intro }}</span>
        {% endif %}
      </p>
    {% endif %}
  </div>

  {% for section in about_page.sections %}
    <section class="collection-section about-section" id="{{ section.id }}">
      <div class="collection-section-heading">
        <h3>{{ section.title }}</h3>
        {% if section.subtitle %}
          <span class="collection-section-subtitle">{{ section.subtitle }}</span>
        {% endif %}
      </div>

      {% if about_page.life_intro.size > 0 %}
        <div class="about-life-lead">
          {% for paragraph in about_page.life_intro %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      {% endif %}

      {% if about_page.life_chapters.size > 0 %}
        <div class="about-life-timeline">
          {% for chapter in about_page.life_chapters %}
            <article class="about-life-chapter" id="{{ chapter.id }}">
              <div class="about-life-chapter-marker" aria-hidden="true"></div>
              <div class="about-life-chapter-content">
                {% if chapter.era %}
                  <p class="about-life-era">{{ chapter.era }}</p>
                {% endif %}
                <h4 class="about-life-chapter-title">{{ chapter.title }}</h4>
                <div class="about-life-prose">
                  {% for paragraph in chapter.paragraphs %}
                    {{ paragraph | markdownify }}
                  {% endfor %}
                </div>
                {% if chapter.closing_quote %}
                  <blockquote class="about-life-closing-quote">
                    <p>{{ chapter.closing_quote }}</p>
                  </blockquote>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}

      {% if about_page.story_rows.size > 0 %}
        <div class="about-story-stream">
          {% for row in about_page.story_rows %}
            {% assign image_side = row.image_side | default: 'left' %}
            <article class="about-story-row about-story-row--image-{{ image_side }}">
              {% if row.image %}
                <figure class="about-story-media">
                  <img
                    src="{{ row.image | relative_url }}"
                    alt="{{ row.image_alt | default: '' }}"
                    loading="lazy"
                  />
                  {% if row.image_caption %}
                    <figcaption>{{ row.image_caption }}</figcaption>
                  {% endif %}
                </figure>
              {% endif %}
              {% if row.text %}
                <div class="about-story-prose">{{ row.text | markdownify }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% endfor %}
</div>
