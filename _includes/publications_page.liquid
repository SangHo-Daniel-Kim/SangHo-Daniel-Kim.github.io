{% assign publications_page = site.data.publications_page %}

<div class="publications-page collection-page">
  <div class="collection-header">
    <h1>Publications</h1>
    <h2>research papers &amp; preprints</h2>
    {% if publications_page.updated %}
      <p class="collection-updated">Updated {{ publications_page.updated | date: '%b %d, %Y' }}</p>
    {% endif %}
    {% if publications_page.intro_label or publications_page.intro %}
      <p class="collection-intro">
        {% if publications_page.intro_label %}
          <span class="collection-intro-label">{{ publications_page.intro_label }}</span>
        {% endif %}
        {% if publications_page.intro %}
          <span class="collection-intro-text">{{ publications_page.intro }}</span>
        {% endif %}
      </p>
    {% endif %}
  </div>

  {% for section in publications_page.sections %}
    <section class="collection-section publications-section" id="{{ section.id }}">
      <div class="collection-section-heading">
        <h3>{{ section.title }}</h3>
        {% if section.subtitle %}
          <span class="collection-section-subtitle">{{ section.subtitle }}</span>
        {% endif %}
      </div>

      {% if site.bib_search %}
        <div class="publications-toolbar">
          {% include bib_search.liquid %}
        </div>
      {% endif %}

      <div class="publications-list">
        <div class="publications">
          {% bibliography %}
        </div>
      </div>
    </section>
  {% endfor %}
</div>
