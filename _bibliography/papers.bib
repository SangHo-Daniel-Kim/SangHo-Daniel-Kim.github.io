@article{xue2026personalvcl,
  title={Personal Visual Context Learning in Large Multimodal Models},
  author={Xue, Zihui and Baid, Ami and Kim, Sangho and Luo, Mi and Grauman, Kristen},
  journal={arXiv},
  year={2026},
  eprint={2605.10936},
  archivePrefix={arXiv},
  primaryClass={cs.CV},
  abstract={We introduce Personal Visual Context Learning (Personal VCL), a capability enabling Large Multimodal Models to reason over visual information unique to the user when integrated into wearable devices like smart glasses. We present Personal-VCL-Bench, a benchmark with 2,255 context-query instances across 7 tasks examining three dimensions of a user's visual world: persons, objects, and behavior. Testing seven frontier LMMs reveals a modality paradox (language summaries outperform raw pixels) and a scaling paradox (more historical context frequently fails to improve accuracy). To address these gaps, we propose the Agentic Context Bank, a model-agnostic baseline that organizes visual history into structured, evidence-linked memory and selectively grounds only relevant entries at inference time.},
  html={https://arxiv.org/abs/2605.10936},
  website={https://vision.cs.utexas.edu/projects/PersonalVCL/},
  preview={personal_vcl_teaser.pdf},
  selected={true}
}
